# ReferralHub Environment Configuration Example
# Copy to .env for local overrides

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/referral_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JWT Security
# Must be at least 32 characters long
JWT_SECRET=replace_this_with_a_secure_random_key_of_at_least_32_characters

# Mailer Configuration (SMTP)
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_app_password

# Application Settings
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
APP_UPLOAD_DIR=uploads
APP_COMPANY_NAME=ReferralHub
APP_RECRUITER_INVITE_CODE=RECRUITER2026
DEMO_PASSWORD=DemoPassword123!

# Frontend Configuration
VITE_API_URL=http://localhost:8080
